      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 21,
      "targets": [
        {
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"dev_db\"} > 0)",
          "legendFormat": "Статус: {{state}}",
          "refId": "A"
        }
      ],
      "title": "Активные подключения к базе (dev_db)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 22,
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[5m]))",
