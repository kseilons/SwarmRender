          "refId": "A"
        }
      ],
      "title": "Скорость сообщений в Kafka (сообщ/сек)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 23,
      "targets": [
        {
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "Группа: {{consumergroup}}",
          "refId": "A"
        }
      ],
      "title": "Лаг в очередях Kafka (Задержка)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "id": 30,
