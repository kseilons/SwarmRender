        "reduceOptions": { "calcs": ["mean"] }
      },
      "targets": [
        { "expr": "(sum(rate(http_requests_total{code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))) * 100", "refId": "A" }
