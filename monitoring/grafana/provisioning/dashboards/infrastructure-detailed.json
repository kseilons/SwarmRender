      "id": 100,
      "title": "Database Deep Dive (PostgreSQL)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "decbytes" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "sum(pg_database_size_bytes)", "refId": "A" } ],
      "title": "Total DB Size",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "expr": "pg_stat_activity_count", "refId": "A" } ],
      "title": "Active Connections",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit[5m])", "legendFormat": "Commits", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback[5m])", "legendFormat": "Rollbacks", "refId": "B" }
      ],
      "title": "Transaction Throughput",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Messaging Pipeline (Kafka)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 10,
      "targets": [
        { "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[5m]))", "legendFormat": "{{topic}} (msgs/s)", "refId": "A" }
      ],
      "title": "Messages Inbound Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 11,
      "options": { "displayMode": "lcd", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum by (consumergroup) (kafka_consumergroup_lag)", "legendFormat": "{{consumergroup}}", "refId": "A" }
      ],
      "title": "Consumer Lag by Group",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Object Storage (Minio/S3)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 20,
      "targets": [
        { "expr": "sum(rate(minio_s3_requests_total[5m]))", "legendFormat": "Total Requests", "refId": "A" },
        { "expr": "sum(rate(minio_s3_requests_errors_total[5m]))", "legendFormat": "Errors", "refId": "B" }
      ],
      "title": "S3 API Traffic",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "decbytes" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 21,
      "targets": [ { "expr": "minio_cluster_disk_usage_total_bytes", "refId": "A" } ],
      "title": "Total Storage Used",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 22,
      "targets": [ { "expr": "minio_cluster_disk_usage_total_bytes / minio_cluster_disk_total_bytes * 100", "refId": "A" } ],
      "title": "Storage Fill Percentage",
      "type": "gauge"
    }
